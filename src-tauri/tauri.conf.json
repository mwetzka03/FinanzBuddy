{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinanzBuddy",
  "version": "0.2.0",
  "identifier": "com.mawet.finanzbuddy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FinanzBuddy",
        "width": 1100,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "FinanzBuddy – personal finance planning",
    "longDescription": "FinanzBuddy – offline ledger, forecasts, budgets and portfolio tracking."
  }
}

